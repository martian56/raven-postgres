// raven-postgres: a PostgreSQL client written in pure Raven.
//
// It speaks the PostgreSQL v3 frontend/backend wire protocol directly over a
// std/net TCP stream: a startup handshake, authentication, the simple query
// protocol, and parameterized queries via the extended protocol (text-format
// results). No native dependencies.
//
// Supported auth: trust (AuthenticationOk) and cleartext password. MD5 and
// SCRAM-SHA-256 are not implemented yet (they need MD5/SHA-256 in the runtime)
// and return a clear error.
//
// Usage:
//   from "github.com/martian56/raven-postgres" import connect
//   let conn = connect("127.0.0.1", 5432, "user", "pass", "mydb")?
//   let res = conn.query("SELECT id, name FROM users")?
//   for row in res.rows { println(row.get(0)) }
//   conn.close()

import std.net
from std.net import TcpStream
import std.string
from std.error import error_kind

let MAX_MESSAGE_SIZE: int = 268435456
let MAX_BIND_PARAMETERS: int = 65535

// ===== handle and result types =====

// A live connection to a PostgreSQL server.
class Connection {
    stream: TcpStream
    server_version: str
    backend_pid: int
}

class ParameterStatus {
    name: str
    value: str
}

class SessionInfo {
    server_version: str
    backend_pid: int
}

// One decoded backend message: a type byte and its raw payload bytes.
class Message {
    mtype: int
    payload: str
}

// A result row. Values are the text-format column values; `nulls[i]` is true
// when column i was SQL NULL (and `values[i]` is the empty string).
class Row {
    values: list[str]
    nulls: list[bool]
}

// The result of a query: the column names from the row description, the rows,
// and the affected-row count parsed from the command tag (INSERT/UPDATE/DELETE).
class QueryResult {
    columns: list[str]
    rows: list[Row]
    affected: int
}

// ===== byte toolkit =====

// A one-byte string holding byte value `n` (low 8 bits).
fun chr(n: int) -> str {
    return __str_from_byte(n & 255)
}

// `s` followed by a NUL terminator (a C string).
fun cstr(s: str) -> str {
    return s.concat(chr(0))
}

// Big-endian 16-bit and 32-bit integers as 2 and 4 byte strings.
fun int16_be(n: int) -> str {
    return chr((n >> 8) & 255).concat(chr(n & 255))
}

fun int32_be(n: int) -> str {
    var out = chr((n >> 24) & 255)
    out = out.concat(chr((n >> 16) & 255))
    out = out.concat(chr((n >> 8) & 255))
    out = out.concat(chr(n & 255))
    return out
}

// Read big-endian integers out of a buffer at byte offset `off`.
fun read_int16_be(s: str, off: int) -> int {
    return (__str_byte_at(s, off) << 8) | __str_byte_at(s, off + 1)
}

fun read_int32_be(s: str, off: int) -> int {
    let b0 = __str_byte_at(s, off)
    let b1 = __str_byte_at(s, off + 1)
    let b2 = __str_byte_at(s, off + 2)
    let b3 = __str_byte_at(s, off + 3)
    return (b0 << 24) | (b1 << 16) | (b2 << 8) | b3
}

// Index of the next NUL byte at or after `from`, or the length if none.
fun find_nul(s: str, from: int) -> int {
    var i = from
    let n = s.length()
    while i < n {
        if __str_byte_at(s, i) == 0 {
            return i
        }
        i = i + 1
    }
    return n
}

// Parse a run of ASCII digits into an int; any non-digit yields 0.
fun digits_to_int(s: str) -> int {
    let n = s.length()
    if n == 0 {
        return 0
    }
    var result = 0
    var i = 0
    while i < n {
        let c = __str_byte_at(s, i)
        if c >= 48 and c <= 57 {
            result = result * 10 + (c - 48)
        } else {
            return 0
        }
        i = i + 1
    }
    return result
}

fun has_nul(value: str) -> bool {
    return value.contains(chr(0))
}

fun validate_cstring(label: str, value: str) -> Result[bool, Error] {
    if has_nul(value) {
        return Err(error_kind("postgres", "${label} cannot contain a NUL byte"))
    }
    return Ok(true)
}

// ===== framing =====

// Build a typed frontend message: the type byte, an int32 length covering the
// length field and the payload, then the payload.
fun frame(mtype: str, payload: str) -> str {
    return mtype.concat(int32_be(4 + payload.length())).concat(payload)
}

// The startup packet (it has no type byte): protocol 3.0 then NUL-terminated
// parameter key/value pairs, ending with an extra NUL.
fun startup_message(user: str, database: str) -> str {
    var body = int32_be(196608)
    body = body.concat(cstr("user")).concat(cstr(user))
    body = body.concat(cstr("database")).concat(cstr(database))
    body = body.concat(chr(0))
    return int32_be(4 + body.length()).concat(body)
}

// Read exactly `n` bytes, looping until they all arrive. A clean EOF is an
// error, since the protocol never closes mid-message.
fun read_exact(stream: TcpStream, n: int) -> Result[str, Error] {
    var buf = ""
    var have = 0
    while have < n {
        let chunk = stream.read(n - have)?
        if chunk.length() == 0 {
            return Err(error_kind("postgres", "connection closed by server"))
        }
        buf = buf.concat(chunk)
        have = have + chunk.length()
    }
    return Ok(buf)
}

fun write_all(stream: TcpStream, data: str) -> Result[int, Error] {
    var written = 0
    while written < data.length() {
        let count = stream.write(data.substring(written, data.length()))?
        if count <= 0 {
            return Err(error_kind("postgres", "connection stopped accepting message bytes"))
        }
        written = written + count
    }
    return Ok(written)
}

// Read one backend message: a 1-byte type, an int32 length, then the payload.
fun read_message(stream: TcpStream) -> Result[Message, Error] {
    return read_message_after(read_exact(stream, 5)?, stream)
}

let NOT_POSTGRES = "the server did not answer as PostgreSQL (is this the right host and port?)"

// The first reply to a startup message is always Authentication (R) or an
// ErrorResponse (E); anything else means the port is not a Postgres server.
fun read_first_message(stream: TcpStream) -> Result[Message, Error] {
    let header = read_exact(stream, 5)?
    let mtype = __str_byte_at(header, 0)
    if mtype != 82 and mtype != 69 {
        return Err(error_kind("postgres", NOT_POSTGRES))
    }
    return read_message_after(header, stream)
}

fun read_message_after(header: str, stream: TcpStream) -> Result[Message, Error] {
    let mtype = __str_byte_at(header, 0)
    let len = read_int32_be(header, 1)
    if len < 4 {
        return Err(error_kind("postgres", "invalid backend message length ${len}"))
    }
    if len > MAX_MESSAGE_SIZE {
        return Err(error_kind("postgres", "backend message exceeds the 256 MiB safety limit"))
    }
    var payload = ""
    if len > 4 {
        payload = read_exact(stream, len - 4)?
    }
    return Ok(Message(mtype: mtype, payload: payload))
}

// ===== extended query protocol (parameterized statements) =====
//
// Parse + Bind + Describe + Execute + Sync sent as one batch. Parameters are
// bound in text format with their types left for the server to infer, so values
// are passed as strings and never interpolated into the SQL.

// Parse: an unnamed prepared statement for `sql` with no declared parameter
// types (the server infers them).
fun parse_message(sql: str) -> str {
    let payload = cstr("").concat(cstr(sql)).concat(int16_be(0))
    return frame("P", payload)
}

// Bind the unnamed portal to the unnamed statement, all parameters and results
// in text format. A NULL parameter is sent as length -1; here every value is a
// non-null string.
fun bind_message_optional(params: list[Option[str]]) -> str {
    var payload = cstr("").concat(cstr(""))
    payload = payload.concat(int16_be(0))
    payload = payload.concat(int16_be(params.len()))
    for p in params {
        match p {
            case Some(value) {
                payload = payload.concat(int32_be(value.length())).concat(value)
            }
            case None {
                payload = payload.concat(int32_be(4294967295))
            }
        }
    }
    payload = payload.concat(int16_be(0))
    return frame("B", payload)
}

fun validate_bind_params(params: list[Option[str]]) -> Result[bool, Error] {
    if params.len() > MAX_BIND_PARAMETERS {
        return Err(error_kind("postgres", "too many bind parameters; maximum is 65535"))
    }
    for param in params {
        match param {
            case Some(value) {
                if value.length() > 2147483647 {
                    return Err(error_kind("postgres", "bind parameter exceeds the protocol limit"))
                }
            }
            case None {}
        }
    }
    return Ok(true)
}

fun extended_query(sql: str, params: list[Option[str]]) -> Result[str, Error] {
    let _ = validate_cstring("SQL", sql)?
    let _ = validate_bind_params(params)?
    var batch = parse_message(sql)
    batch = batch.concat(bind_message_optional(params))
    batch = batch.concat(describe_portal_message())
    batch = batch.concat(execute_message())
    batch = batch.concat(sync_message())
    return Ok(batch)
}

fun text_params(params: list[str]) -> list[Option[str]] {
    let out: list[Option[str]] = []
    for value in params {
        out.push(Some(value))
    }
    return out
}

fun bind_message(params: list[str]) -> str {
    return bind_message_optional(text_params(params))
}

// Describe the unnamed portal, so the server returns a RowDescription.
fun describe_portal_message() -> str {
    return frame("D", chr(80).concat(cstr("")))
}

// Execute the unnamed portal with no row limit.
fun execute_message() -> str {
    return frame("E", cstr("").concat(int32_be(0)))
}

// Sync: end the batch and ask for ReadyForQuery.
fun sync_message() -> str {
    return frame("S", "")
}

// ===== payload parsing =====

// An ErrorResponse / NoticeResponse payload: typed, NUL-terminated fields ended
// by a zero type byte. We surface severity, SQLSTATE code, and message.
fun parse_error(payload: str) -> Error {
    var off = 0
    let n = payload.length()
    var message = ""
    var code = ""
    var severity = ""
    while off < n {
        let ftype = __str_byte_at(payload, off)
        if ftype == 0 {
            off = n
        } else {
            off = off + 1
            let end = find_nul(payload, off)
            let val = payload.substring(off, end)
            if ftype == 77 {
                message = val
            }
            if ftype == 67 {
                code = val
            }
            if ftype == 83 {
                severity = val
            }
            off = end + 1
        }
    }
    return error_kind("postgres", "${severity} ${code}: ${message}")
}

fun parse_parameter_status(payload: str) -> Result[ParameterStatus, Error] {
    let name_end = find_nul(payload, 0)
    if name_end >= payload.length() {
        return Err(error_kind("postgres", "malformed ParameterStatus message"))
    }
    let value_start = name_end + 1
    let value_end = find_nul(payload, value_start)
    if value_end >= payload.length() {
        return Err(error_kind("postgres", "malformed ParameterStatus message"))
    }
    if value_end + 1 != payload.length() {
        return Err(error_kind("postgres", "ParameterStatus message has trailing data"))
    }
    return Ok(
        ParameterStatus(
            name: payload.substring(0, name_end),
            value: payload.substring(value_start, value_end),
        ),
    )
}

// RowDescription: an int16 field count, then per field a NUL-terminated name
// followed by 18 bytes of OID/length/format metadata we skip.
fun parse_row_description(payload: str) -> list[str] {
    let cols: list[str] = []
    let count = read_int16_be(payload, 0)
    var off = 2
    var i = 0
    while i < count {
        let end = find_nul(payload, off)
        cols.push(payload.substring(off, end))
        off = end + 1 + 18
        i = i + 1
    }
    return cols
}

fun parse_row_description_checked(payload: str) -> Result[list[str], Error] {
    if payload.length() < 2 {
        return Err(error_kind("postgres", "truncated RowDescription message"))
    }
    let cols: list[str] = []
    let count = read_int16_be(payload, 0)
    var off = 2
    var i = 0
    while i < count {
        let end = find_nul(payload, off)
        if end >= payload.length() or end + 1 + 18 > payload.length() {
            return Err(error_kind("postgres", "truncated RowDescription field"))
        }
        cols.push(payload.substring(off, end))
        off = end + 1 + 18
        i = i + 1
    }
    if off != payload.length() {
        return Err(error_kind("postgres", "RowDescription message has trailing data"))
    }
    return Ok(cols)
}

// DataRow: an int16 column count, then per column an int32 byte length (a length
// of -1, encoded as 0xFFFFFFFF, means NULL) followed by that many text bytes.
fun parse_data_row(payload: str) -> Row {
    let values: list[str] = []
    let nulls: list[bool] = []
    let count = read_int16_be(payload, 0)
    var off = 2
    var i = 0
    while i < count {
        let len = read_int32_be(payload, off)
        off = off + 4
        if len == 4294967295 {
            values.push("")
            nulls.push(true)
        } else {
            values.push(payload.substring(off, off + len))
            nulls.push(false)
            off = off + len
        }
        i = i + 1
    }
    return Row(values: values, nulls: nulls)
}

fun parse_data_row_checked(payload: str) -> Result[Row, Error] {
    if payload.length() < 2 {
        return Err(error_kind("postgres", "truncated DataRow message"))
    }
    let values: list[str] = []
    let nulls: list[bool] = []
    let count = read_int16_be(payload, 0)
    var off = 2
    var i = 0
    while i < count {
        if off + 4 > payload.length() {
            return Err(error_kind("postgres", "truncated DataRow column length"))
        }
        let len = read_int32_be(payload, off)
        off = off + 4
        if len == 4294967295 {
            values.push("")
            nulls.push(true)
        } else {
            if off + len > payload.length() {
                return Err(error_kind("postgres", "truncated DataRow column value"))
            }
            values.push(payload.substring(off, off + len))
            nulls.push(false)
            off = off + len
        }
        i = i + 1
    }
    if off != payload.length() {
        return Err(error_kind("postgres", "DataRow message has trailing data"))
    }
    return Ok(Row(values: values, nulls: nulls))
}

// CommandComplete tag, e.g. "INSERT 0 5", "UPDATE 3", "SELECT 10". The affected
// count is the last whitespace-separated token when it is numeric, else 0.
fun parse_affected(payload: str) -> int {
    let end = find_nul(payload, 0)
    let tag = payload.substring(0, end)
    var i = tag.length() - 1
    var start = 0
    while i >= 0 {
        if __str_byte_at(tag, i) == 32 {
            start = i + 1
            i = 0 - 1
        } else {
            i = i - 1
        }
    }
    return digits_to_int(tag.substring(start, tag.length()))
}

// After an error mid-exchange, read until ReadyForQuery so the connection can be
// reused. Best effort: any read failure just ends the drain.
fun drain_until_ready(stream: TcpStream) {
    var done = false
    while not done {
        match read_message(stream) {
            case Ok(msg) {
                if msg.mtype == 90 {
                    done = true
                }
            }
            case Err(e) {
                done = true
            }
        }
    }
}

// Read backend messages until ReadyForQuery, building the result. Shared by the
// simple and extended query paths; both produce the same T/D/C/E/Z stream, and
// the ParseComplete/BindComplete/ParameterDescription/NoData messages the
// extended path adds are simply ignored here.
fun read_query_result(stream: TcpStream) -> Result[QueryResult, Error] {
    var columns: list[str] = []
    let rows: list[Row] = []
    var affected = 0
    var saw_description = false
    var done = false
    while not done {
        let msg = read_message(stream)?
        if msg.mtype == 84 {
            if saw_description {
                drain_until_ready(stream)
                return Err(error_kind("postgres", "multiple row result sets are not supported"))
            }
            columns = parse_row_description_checked(msg.payload)?
            saw_description = true
        } else if msg.mtype == 68 {
            if not saw_description {
                drain_until_ready(stream)
                return Err(error_kind("postgres", "DataRow arrived before RowDescription"))
            }
            let row = parse_data_row_checked(msg.payload)?
            if row.values.len() != columns.len() {
                drain_until_ready(stream)
                return Err(error_kind("postgres", "DataRow column count does not match RowDescription"))
            }
            rows.push(row)
        } else if msg.mtype == 67 {
            affected = parse_affected(msg.payload)
        } else if msg.mtype == 69 {
            let perr = parse_error(msg.payload)
            drain_until_ready(stream)
            return Err(perr)
        } else if msg.mtype == 90 {
            if msg.payload.length() != 1 {
                return Err(error_kind("postgres", "malformed ReadyForQuery message"))
            }
            done = true
        } else if msg.mtype == 71 {
            let _ = write_all(
                stream,
                frame("f", cstr("COPY FROM STDIN is not supported by raven-postgres")),
            )?
            drain_until_ready(stream)
            return Err(error_kind("postgres", "COPY FROM STDIN is not supported"))
        } else if msg.mtype == 72 or msg.mtype == 87 {
            drain_until_ready(stream)
            return Err(error_kind("postgres", "COPY streaming is not supported"))
        }
    }
    return Ok(QueryResult(columns: columns, rows: rows, affected: affected))
}

fun authentication_method(payload: str) -> Result[int, Error] {
    if payload.length() < 4 {
        return Err(error_kind("postgres", "malformed AuthenticationRequest message"))
    }
    return Ok(read_int32_be(payload, 0))
}

// Run the startup authentication loop until ReadyForQuery.
fun authenticate(stream: TcpStream, password: str) -> Result[SessionInfo, Error] {
    var server_version = ""
    var backend_pid = 0
    var done = false
    var first = true
    while not done {
        let msg = read_first_message(stream)? if first else read_message(stream)?
        first = false
        if msg.mtype == 82 {
            let auth = authentication_method(msg.payload)?
            if auth == 0 {
                let ok = true
            } else if auth == 3 {
                let _ = write_all(stream, frame("p", cstr(password)))?
            } else {
                return Err(
                    error_kind(
                        "postgres",
                        "unsupported auth method ${auth}; only trust and cleartext password are supported",
                    ),
                )
            }
        } else if msg.mtype == 69 {
            return Err(parse_error(msg.payload))
        } else if msg.mtype == 83 {
            let status = parse_parameter_status(msg.payload)?
            if status.name == "server_version" {
                server_version = status.value
            }
        } else if msg.mtype == 75 {
            if msg.payload.length() != 8 {
                return Err(error_kind("postgres", "malformed BackendKeyData message"))
            }
            backend_pid = read_int32_be(msg.payload, 0)
        } else if msg.mtype == 90 {
            if msg.payload.length() != 1 {
                return Err(error_kind("postgres", "malformed ReadyForQuery message"))
            }
            done = true
        }
    }
    return Ok(SessionInfo(server_version: server_version, backend_pid: backend_pid))
}

// ===== public API =====

fun establish_connection(
    stream: TcpStream,
    user: str,
    password: str,
    database: str,
) -> Result[Connection, Error] {
    let _ = validate_cstring("user", user)?
    let _ = validate_cstring("database", database)?
    let _ = validate_cstring("password", password)?
    let _ = write_all(stream, startup_message(user, database))?
    let session = authenticate(stream, password)?
    return Ok(
        Connection(
            stream: stream,
            server_version: session.server_version,
            backend_pid: session.backend_pid,
        ),
    )
}

// Connect with a read/write timeout for authentication and later commands.
// A non-positive timeout restores blocking socket behavior.
fun connect_with_timeout(
    host: str,
    port: int,
    user: str,
    password: str,
    database: str,
    timeout_ms: int,
) -> Result[Connection, Error] {
    let stream = net.connect("${host}:${port}")?
    stream.set_read_timeout_ms(timeout_ms)
    stream.set_write_timeout_ms(timeout_ms)
    return match establish_connection(stream, user, password, database) {
        case Ok(connection) { Ok(connection) }
        case Err(e) {
            stream.close()
            Err(e)
        }
    }
}

// Connect to a PostgreSQL server and authenticate. `host` is a name or IP,
// `port` the TCP port (usually 5432). A 30-second socket timeout is applied.
fun connect(
    host: str,
    port: int,
    user: str,
    password: str,
    database: str,
) -> Result[Connection, Error] {
    return connect_with_timeout(host, port, user, password, database, 30000)
}

impl Connection {
    // Change the read and write timeout used by later commands.
    fun set_timeout_ms(self, timeout_ms: int) {
        self.stream.set_read_timeout_ms(timeout_ms)
        self.stream.set_write_timeout_ms(timeout_ms)
    }

    // Verify that the server accepts a query on this connection.
    fun ping(self) -> Result[bool, Error] {
        let result = self.query("SELECT 1")?
        return Ok(result.row_count() == 1 and result.rows[0].get(0) == "1")
    }

    // Run a SQL statement and collect its result. Works for any statement: a
    // SELECT fills `columns` and `rows`, a write fills `affected`.
    fun query(self, sql: str) -> Result[QueryResult, Error] {
        let _ = validate_cstring("SQL", sql)?
        let _ = write_all(self.stream, frame("Q", cstr(sql)))?
        return read_query_result(self.stream)
    }

    // Run a statement with bound parameters, referenced in `sql` as $1, $2, ...
    // Values are passed as text and never interpolated into the SQL, so this is
    // the safe way to pass user input. Types are inferred from context (column
    // types, casts), e.g. "INSERT INTO t (n) VALUES ($1)" or "... WHERE id = $1".
    fun query_params(self, sql: str, params: list[str]) -> Result[QueryResult, Error] {
        let batch = extended_query(sql, text_params(params))?
        let _ = write_all(self.stream, batch)?
        return read_query_result(self.stream)
    }

    // Parameterized query variant that can bind SQL NULL with `None`.
    fun query_optional_params(
        self,
        sql: str,
        params: list[Option[str]],
    ) -> Result[QueryResult, Error] {
        let batch = extended_query(sql, params)?
        let _ = write_all(self.stream, batch)?
        return read_query_result(self.stream)
    }

    // Run a statement and return just the affected-row count.
    fun execute(self, sql: str) -> Result[int, Error] {
        let res = self.query(sql)?
        return Ok(res.affected)
    }

    // Run a parameterized statement and return just the affected-row count.
    fun execute_params(self, sql: str, params: list[str]) -> Result[int, Error] {
        let res = self.query_params(sql, params)?
        return Ok(res.affected)
    }

    // Parameterized write variant that can bind SQL NULL with `None`.
    fun execute_optional_params(self, sql: str, params: list[Option[str]]) -> Result[int, Error] {
        let res = self.query_optional_params(sql, params)?
        return Ok(res.affected)
    }

    // Send Terminate and close the socket. Best effort.
    fun close(self) {
        let _ = write_all(self.stream, frame("X", ""))
        self.stream.close()
    }
}

impl Row {
    // Text value of column `i`. Empty string when the column is NULL; check
    // `is_null` to tell an empty string from a NULL.
    fun get(self, i: int) -> str {
        return self.values[i]
    }

    // Whether column `i` was SQL NULL.
    fun is_null(self, i: int) -> bool {
        return self.nulls[i]
    }
}

impl QueryResult {
    // Number of rows returned.
    fun row_count(self) -> int {
        return self.rows.len()
    }
}
